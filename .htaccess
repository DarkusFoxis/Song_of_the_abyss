ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
Options -Indexes

<FilesMatch "^(?:\.|.*\.pem$|secrets\.php$)">
    Require all denied
</FilesMatch>
# Включаем обработку файлов .htaccess
RewriteEngine On
RewriteRule ^(?:keys|encrypted_attachments)(?:/|$) - [F,L,NC]
RewriteRule ^(?:uploads|profile/avatars|profile/arts|abyss_net/(?:media|icon))/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$ - [F,L,NC]

# Удаляем расширение .html из URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Удаляем расширение .php из URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
